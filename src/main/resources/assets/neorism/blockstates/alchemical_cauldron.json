{
  "multipart": [
    {
      "apply": {
        "model": "neorism:block/alchemy_cauldron"
      }
    },
    {
      "apply": {
        "model": "neorism:block/alchemy_cauldron_fire"
      },
      "when": {
        "lit": "true"
      }
    },
    {
      "apply": {
        "model": "neorism:block/alchemy_cauldron_liquid"
      },
      "when": {
        "liquid": "filled"
      }
    },
    {
      "apply": {
        "model": "neorism:block/alchemical_cauldron_boiling"
      },
      "when": {
        "liquid": "boiling"
      }
    }
  ]
}